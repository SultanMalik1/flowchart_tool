# Required for Groq models. Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Required when a flowchart model id starts with gemini- or gemma-.
# Get a key at https://aistudio.google.com/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=

# Optional model overrides. A gemini id uses Google; any other id uses Groq.
# FLOWCHART_TEXT_MODEL=gemini-flash-latest
# FLOWCHART_IMAGE_MODEL=gemini-flash-latest
# FLOWCHART_NATIVE_TEXT_MODEL=gemini-flash-latest

# Optional directory for saved diagrams (default: .data/flowcharts)
# FLOWCHART_DATA_DIR=

# Optional. Only needed for the newsletter and contact forms.
# RESEND_API_KEY=
# RESEND_AUDIENCE_ID=

# NEXT_PUBLIC_BASE_URL=http://localhost:3000
